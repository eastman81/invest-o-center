# Supabase: create a project at https://supabase.com/dashboard
# Run the migration in SQL Editor: supabase/migrations/00001_initial_schema.sql
# Use the Publishable key (sb_publishable_...). Never use the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Edge Function "refresh-item-price": set in Supabase Dashboard → Project Settings → Edge Functions → Secrets.
# App uses these keys for all users; users can optionally override with their own in Account → API keys.
#   ALPHA_VANTAGE_API_KEY=your_key_from_https://www.alphavantage.co/support/#api-key
#   RENTCAST_API_KEY=your_key_from_https://app.rentcast.io/app/api (real estate / home value)
